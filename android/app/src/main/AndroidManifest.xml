<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Dibutuhkan untuk memanggil https://api.patio.my.id. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Izin khusus untuk fitur Kontrol Perangkat (lihat DeviceLockService). SYSTEM_ALERT_WINDOW
        TIDAK memicu dialog izin otomatis - wajib diberikan MANUAL oleh pengguna lewat halaman
        Pengaturan sistem (transparan, terlihat di "Akses khusus", bisa dicabut kapan saja).
        Bukan accessibility service, bukan root, bukan device admin/owner - sesuai batasan PRD.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PactioApplication"
        android:allowBackup="true"
        android:label="Pactio"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.KendaliKeluarga">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.DeviceLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Memantau aplikasi yang sedang dibuka anak untuk menegakkan kunci perangkat yang diaktifkan orang tua." />
        </service>

        <!--
            Dibutuhkan supaya orang tua bisa membuka berkas bukti PDF yang diunduh dari server
            (di cache app) lewat aplikasi pembaca PDF yang sudah ada di HP - Android 7+ tidak
            lagi mengizinkan berbagi URI file:// langsung antar aplikasi, harus lewat
            content:// resmi seperti ini. exported="false" + grantUriPermissions="true": hanya
            aplikasi yang benar-benar diberi izin lewat Intent (mis. pembaca PDF yang dipilih
            pengguna) yang bisa membaca berkasnya, bukan aplikasi lain sembarangan.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
