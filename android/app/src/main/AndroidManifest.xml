<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Dibutuhkan untuk memanggil https://timecraft.my.id. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Izin khusus untuk fitur Kontrol Perangkat/kunci layar (lihat DeviceLockService).
        SYSTEM_ALERT_WINDOW TIDAK memicu dialog izin otomatis - wajib diberikan MANUAL oleh
        pengguna lewat halaman Pengaturan sistem (transparan, terlihat di "Akses khusus", bisa
        dicabut kapan saja). Bukan accessibility service, bukan root - sesuai batasan PRD.
        (Device admin DIPAKAI di bawah, tapi HANYA untuk proteksi anti-uninstall - fitur
        terpisah, lihat UninstallProtectionAdminReceiver - bukan untuk kunci layar ini.)
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PactioApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="TimeCraft"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.KendaliKeluarga">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.DeviceLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Memantau aplikasi yang sedang dibuka anak untuk menegakkan kunci perangkat yang diaktifkan orang tua." />
        </service>

        <!--
            Device admin KHUSUS proteksi anti-uninstall (lihat komentar lengkap di
            UninstallProtectionAdminReceiver.kt) - orang tua mengaktifkannya sendiri lewat
            dialog sistem resmi Android (ACTION_ADD_DEVICE_ADMIN) di menu Pengaturan aplikasi,
            bukan diam-diam. exported="true" WAJIB untuk device-admin receiver (sistem Android
            yang memanggilnya), tapi dilindungi permission BIND_DEVICE_ADMIN bawaan platform -
            hanya sistem Android sendiri yang bisa mengikatnya, bukan aplikasi lain sembarangan.
        -->
        <receiver
            android:name=".service.UninstallProtectionAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            Dibutuhkan supaya orang tua bisa membuka berkas bukti PDF yang diunduh dari server
            (di cache app) lewat aplikasi pembaca PDF yang sudah ada di HP - Android 7+ tidak
            lagi mengizinkan berbagi URI file:// langsung antar aplikasi, harus lewat
            content:// resmi seperti ini. exported="false" + grantUriPermissions="true": hanya
            aplikasi yang benar-benar diberi izin lewat Intent (mis. pembaca PDF yang dipilih
            pengguna) yang bisa membaca berkasnya, bukan aplikasi lain sembarangan.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
